# Booking Confirmation Page
msgid "Booking Confirmation"
msgstr "Buchungsbestätigung"

msgid "Room:"
msgstr "Raum:"

msgid "Date:"
msgstr "Datum:"

msgid "Time:"
msgstr "Zeit:"

msgid "Duration:"
msgstr "Dauer:"

msgid "Customer Details"
